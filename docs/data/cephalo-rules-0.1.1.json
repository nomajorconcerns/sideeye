[
 {
  "id": "no-drop",
  "description": "Dropping tables or databases",
  "type": "command",
  "on": null,
  "pattern": "\\bDROP\\s+(TABLE|DATABASE|SCHEMA)\\b",
  "action": "block"
 },
 {
  "id": "no-truncate",
  "description": "Truncating tables",
  "type": "command",
  "on": null,
  "pattern": "\\bTRUNCATE\\s+(TABLE\\s+)?[\\w.\"]+",
  "action": "block"
 },
 {
  "id": "no-delete-all",
  "description": "DELETE FROM with no WHERE clause",
  "type": "command",
  "on": null,
  "pattern": "\\bDELETE\\s+FROM\\s+[\\w.\"]+\\s*(;|\"|$)",
  "action": "block"
 },
 {
  "id": "no-rm-rf",
  "description": "Recursive forced rm",
  "type": "command",
  "on": null,
  "pattern": "\\brm\\s+-(?=[a-z]*r)(?=[a-z]*f)[a-z]+",
  "action": "block"
 },
 {
  "id": "no-win-recursive-delete",
  "description": "Recursive delete on Windows",
  "type": "command",
  "on": null,
  "pattern": "(Remove-Item\\b(?=.*-Recurse)(?=.*-Force))|(\\b(rd|rmdir)\\s+\\/s\\b)|(\\bdel\\s+.*\\/s\\b)",
  "action": "block"
 },
 {
  "id": "no-force-push",
  "description": "Force pushing to git remotes",
  "type": "command",
  "on": null,
  "pattern": "\\bgit\\s+push\\b(?=.*(\\s--force(?!-with-lease)\\b|\\s-f\\b))",
  "action": "block"
 },
 {
  "id": "no-force-push-refspec",
  "description": "Force pushing with a + refspec (git push origin +main)",
  "type": "command",
  "on": null,
  "pattern": "\\bgit(\\s+-[cC]\\s+\\S+)*\\s+push\\b[^;&|\\n]*\\s[\"']?\\+[^\\s;&|]",
  "action": "block"
 },
 {
  "id": "no-pipe-to-shell",
  "description": "Piping output into a shell, eval of a substitution, or running a substitution as a script (ask the user to run installers)",
  "type": "command",
  "on": null,
  "pattern": "\\|&?\\s*(sudo\\s+(-\\S+\\s+)*)?(env\\s+)?(\\/(usr\\/)?bin\\/)?(ba|z|da|k)?sh(?=[\\s;&|)]|$)|\\beval\\s+[\"']?(\\$\\(|`)|\\b(ba|z|da|k)?sh\\s+(-\\S+\\s+)*<\\(|\\b(ba|z|da|k)?sh\\s+-c\\s+[\"']?\\$\\(|\\bsource\\s+<\\(",
  "action": "block"
 },
 {
  "id": "no-hard-reset",
  "description": "git reset --hard",
  "type": "command",
  "on": null,
  "pattern": "\\bgit\\s+reset\\s+--hard\\b",
  "action": "block"
 },
 {
  "id": "no-secret-read",
  "description": "Reading .env secret files via shell",
  "type": "command",
  "on": null,
  "pattern": "\\b(cat|type|Get-Content|gc|more|less|head|tail)\\b.*\\.env\\b(?!\\.example)",
  "action": "block"
 },
 {
  "id": "no-secret-file",
  "description": "Accessing .env secret files",
  "type": "path",
  "on": "any",
  "pattern": "(^|[\\/\\\\])\\.env(\\.(?!example$)[\\w.-]+)?$",
  "action": "block"
 },
 {
  "id": "protect-config",
  "description": "Writing Claude Code or Hermes config",
  "type": "path",
  "on": "write",
  "pattern": "[\\/\\\\]\\.claude[\\/\\\\]settings(\\.local)?\\.json$|[\\/\\\\]hermes[\\/\\\\]config\\.yaml$",
  "action": "block"
 }
]